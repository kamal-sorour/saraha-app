# MongoDB connection string
DB_URI=mongodb+srv://user:password@cluster.mongodb.net/saraha

# Redis connection string (name as used in the code)
RUDIS_URI=redis://localhost:6379

# bcrypt / argon2 salt rounds
SALT_ROUND=10

# Generate using: openssl rand -base64 32
ENC_KEY_BASE64=replace-with-a-generated-32-byte-base64-key
# Set only while migrating previously encrypted values; must be the original raw 32-byte key
LEGACY_ENC_BYTE=

# App name used in emails
APPLICATION_NAME=Saraha App

# JWT secrets (user + system, access + refresh)
USER_TOKEN_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
USER_REFRESH_TOKEN_SECRET_KEY=replace-with-another-random-secret-32-chars-minimum
System_TOKEN_SECRET_KEY=replace-with-a-third-random-secret-32-characters-min
System_REFRESH_TOKEN_SECRET_KEY=replace-with-a-fourth-random-secret-32-chars

# Token TTLs (seconds)
ACCESS_EXPIRES_IN=3600
REFRESH_EXPIRES_IN=604800

# Gmail sender (app password required)
EMAIL_APP=your_email@gmail.com
EMAIL_APP_PASSWORD=your_app_password

# Comma-separated allowed origins
ORIGINS=http://localhost:3000

# Local port
PORT=3000

# Set only when running behind a trusted reverse proxy (number of proxy hops)
# TRUST_PROXY_HOPS=1
